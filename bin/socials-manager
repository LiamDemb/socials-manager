#!/usr/bin/env bash
# Socials Manager launcher. Local loopback app; data lives outside this folder.
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$APP_DIR/.venv"
PY="$VENV/bin/python"
NEW_ROOT="$HOME/Library/Application Support/SocialsManager"
LEGACY_ROOT="$HOME/Library/Application Support/BandEvidence"
if [[ -n "${SOCIALS_MANAGER_DATA_ROOT:-}" ]]; then
  DATA_ROOT="$SOCIALS_MANAGER_DATA_ROOT"
elif [[ -n "${BAND_EVIDENCE_DATA_ROOT:-}" ]]; then
  DATA_ROOT="$BAND_EVIDENCE_DATA_ROOT"
elif [[ -d "$NEW_ROOT" ]]; then
  DATA_ROOT="$NEW_ROOT"
elif [[ -d "$LEGACY_ROOT" ]]; then
  DATA_ROOT="$LEGACY_ROOT"
else
  DATA_ROOT="$NEW_ROOT"
fi
export SOCIALS_MANAGER_DATA_ROOT="$DATA_ROOT"
cd "$APP_DIR"

need_venv() {
  if [[ ! -x "$PY" ]]; then
    echo "Not set up yet. Run: bin/socials-manager setup" >&2
    exit 1
  fi
}

usage() {
  cat <<EOF
Usage: bin/socials-manager <command>

  setup [--test]          Create .venv and install hash-pinned dependencies (--test adds browser-test tools)
  init --artist NAME [--timezone Australia/Perth]
                          Create a new installation in the data folder (never overwrites existing data)
  migrate-data            Copy a legacy BandEvidence data folder into SocialsManager with verification
  start [--port 8765]     Apply upgrades (with a backup first), start the worker and open the app on 127.0.0.1
  backup [--list]         Make a verified backup now, or list backups
  restore BACKUP_DIR [--promote]
                          Restore into a new folder and verify it; --promote switches to it (stop the app first)
  status                  Show diagnostics
  test                    Run the automated checks (browser checks need: setup --test)

Data folder: $DATA_ROOT
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  setup)
    PYTHON_BIN="${PYTHON:-$(command -v python3.14 || true)}"
    if [[ -z "$PYTHON_BIN" ]]; then
      echo "Python 3.14 is required (for example: brew install python@3.14)." >&2
      exit 1
    fi
    [[ -x "$PY" ]] || "$PYTHON_BIN" -m venv "$VENV"
    "$PY" -m pip install --disable-pip-version-check --require-hashes --no-deps -r requirements.txt
    if [[ "${1:-}" == "--test" ]]; then
      "$PY" -m pip install --disable-pip-version-check --require-hashes --no-deps -r requirements-test.txt
    fi
    echo "Setup complete."
    ;;
  init)
    need_venv
    "$PY" manage.py init_instance "$@"
    ;;
  migrate-data)
    need_venv
    "$PY" manage.py migrate_data_root "$@"
    ;;
  start)
    need_venv
    "$PY" manage.py upgrade
    mkdir -p "$DATA_ROOT/run"
    "$PY" manage.py run_worker >>"$DATA_ROOT/run/worker.log" 2>&1 &
    WORKER_PID=$!
    echo "$WORKER_PID" >"$DATA_ROOT/run/worker.pid"
    "$PY" manage.py serve "$@" &
    SERVER_PID=$!
    cleanup() {
      trap - EXIT INT TERM
      kill -TERM "$SERVER_PID" "$WORKER_PID" 2>/dev/null || true
      wait "$SERVER_PID" "$WORKER_PID" 2>/dev/null || true
      rm -f "$DATA_ROOT/run/worker.pid"
      echo "Socials Manager stopped."
    }
    trap cleanup EXIT INT TERM
    wait "$SERVER_PID" || true
    ;;
  backup)
    need_venv
    "$PY" manage.py backup "$@"
    ;;
  restore)
    need_venv
    "$PY" manage.py restore "$@"
    ;;
  status)
    need_venv
    "$PY" manage.py diagnostics
    ;;
  test)
    need_venv
    "$PY" manage.py test tests "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
