# Copy to .env (never commit .env). Loaded automatically for manage.py commands (not during tests).

# graph.instagram.com — own-account basic profile (user_id, username, account_type)
INSTAGRAM_ACCESS_TOKEN=
# graph.facebook.com — Pages, linked IG business account, insights, Business Discovery
META_ACCESS_TOKEN=
META_APP_ID=
META_GRAPH_VERSION=v21.0

LAST_FM_API_KEY=
LAST_FM_SHARED_SECRET=

# Set to 1 to run tests/test_live_integrations.py against real APIs
SOCIALS_MANAGER_LIVE_TESTS=